{
  "name": "server-node-boilerplate",
  "version": "1.0.1",
  "description": "",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc && copyfiles -u 4 \"src/modules/mails/templates/**/*\" dist/modules/mails/templates && copyfiles -u 2 \"src/views/**/*.{js,ico,css}\" dist/.assets && copyfiles -u 2 \"src/views/**/*\" dist/views && rm -r dist/views/assets && npm run tailwind && npm run version:assets",
    "clean": "rimraf dist",
    "clean:dev": "rimraf src/.assets",
    "start:dev": "npm run clean:dev && concurrently --kill-others \"npm run watch:assets\" \"nodemon\" \"npm run tailwind:dev\" \"browser-sync start --no-open --proxy 'localhost:4003' --files 'src/views/**/*.*' --reload-delay 1000 --port 4043\"",
    "start:prod": "node dist/main.js",
    "watch:assets": "copyfiles -u 2 \"src/views/**/*.{js,ico}\" src/.assets && chokidar 'src/views/**/*' -c 'copyfiles -u 2 \"src/views/**/*.{js,ico}\" src/.assets'",
    "tailwind": "tailwindcss -i src/views/main.css -o dist/.assets/main.css --minify",
    "tailwind:dev": "tailwindcss -i src/views/main.css -o src/.assets/main.css --watch",
    "version:assets": "node scripts/version-assets.js"
  },
  "dependencies": {
    "@kawijsr/server-node": "1.3.6",
    "cookie-session": "2.1.1",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "express": "5.2.1",
    "express-handlebars": "9.0.1",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/cookie-session": "2.0.49",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "browser-sync": "3.0.4",
    "chokidar-cli": "3.0.0",
    "concurrently": "10.0.5",
    "copyfiles": "2.4.1",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
