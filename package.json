{
  "name": "server-node-boilerplate",
  "version": "1.0.1",
  "description": "",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc && ncp src/views/assets dist/.assets && ncp src/views dist/views && rm -r dist/views/assets && npm run tailwind && npm run version:assets",
    "clean": "rimraf dist",
    "start:dev": "ncp src/views/assets src/.assets && concurrently --kill-others \"nodemon\" \"browser-sync start --proxy 'localhost:4003' --files 'src/views/**/*.*' --reload-delay 1500 --port 4043\" \"npm run tailwind:dev\"",
    "start:prod": "node dist/main.js",
    "tailwind": "tailwindcss -i src/views/main.css -o dist/.assets/main.css --minify",
    "tailwind:dev": "tailwindcss -i src/views/main.css -o src/.assets/main.css --watch",
    "version:assets": "node scripts/version-assets.js"
  },
  "dependencies": {
    "@kawijsr/server-node": "1.3.6",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "express": "5.2.1",
    "express-handlebars": "9.0.1",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "browser-sync": "3.0.4",
    "concurrently": "10.0.5",
    "ncp": "2.0.0",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
